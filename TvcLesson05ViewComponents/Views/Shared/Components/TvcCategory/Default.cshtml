
@model IEnumerable<TvcLesson05ViewComponents.Models.TvcCategory>

<ul class="bg-info my-3 list-group">
    <li class="list-group-item active">DANH MỤC</li>
    @foreach (var item in Model)
    {
        <li class="list-group-item">
            <a asp-controller="TvcProduct" asp-action="Index" asp-route-id="@item.CategoryId">
                @item.CategoryName
            </a>
           
        </li>
    }
</ul>
